    <section class="crm-plans" id="tariffs" aria-labelledby="crm-plans-title">
      <div class="container">
        <div class="section__head">
          <p class="section__eyebrow">{{ plansEyebrow | default("Решения") }}</p>
          <h2 class="section__title" id="crm-plans-title">{{ plansTitle | default("Какие бывают CRM?") }}</h2>
        </div>

        <div class="crm-cards{% if planKeys and planKeys | length == 1 %} crm-cards--single{% endif %}">
          {% if not planKeys or "ready" in planKeys %}
          <article class="crm-card crm-card--highlighted crm-card--compact">
            <header class="crm-card__head">
              <h3 class="crm-card__title">Популярные CRM-платформы</h3>
              <p class="crm-card__lead">
                Готовый облачный сервис со стандартными процессами.
              </p>
            </header>
            <div class="crm-card__body">
              <ul class="crm-card__list" role="list">
                <li>Типовые воронки и процессы уже внутри</li>
                <li>Большое число платных интеграций</li>
              </ul>
              <ul class="crm-card__list crm-card__list--cons" role="list">
                <li>Ежемесячная оплата сервиса</li>
                <li>Сложные процессы ограничены платформой</li>
              </ul>
            </div>
            <footer class="crm-card__foot">
              <button class="btn btn--ghost btn--lure-dark crm-card__btn" type="button" data-order-open data-order-source="plan-ready-questions">Задать вопросы</button>
            </footer>
          </article>
          {% endif %}

          {% if not planKeys or "custom" in planKeys %}
          <article class="crm-card crm-card--featured">
            <header class="crm-card__head">
              <p class="crm-card__eyebrow">Рекомендуем</p>
              <h3 class="crm-card__title">Индивидуальная CRM</h3>
              <p class="crm-card__lead">
                Система под Вашу модель продаж, когда готовые CRM уже не справляются.
              </p>
            </header>
            <ul class="crm-card__list" role="list">
              <li>Полная персонализация: экраны, кнопки, внешний вид</li>
              <li>Любая логика, отчёты и интеграции</li>
              <li>Разовая оплата — продукт остаётся Вашим</li>
              <li>Растёт вместе с компанией</li>
            </ul>
            <footer class="crm-card__foot">
              <p class="crm-card__price">от 10.000 ₽</p>
              <button class="btn btn--primary btn--lure-light crm-card__btn" type="button" data-order-open data-order-source="plan-custom-estimate">
                Оценить задачу
                <span class="crm-card__deal" aria-hidden="true">−10%</span>
              </button>
            </footer>
          </article>
          {% endif %}

          {% if not planKeys or "catalog" in planKeys %}
          <article class="crm-card crm-card--popular">
            <header class="crm-card__head">
              <p class="crm-card__eyebrow">Популярное</p>
              <h3 class="crm-card__title">Решение из каталога</h3>
              <p class="crm-card__lead">
                Готовая система под типовой бизнес из нашего каталога.
              </p>
            </header>
            <div class="crm-card__body">
              <ul class="crm-card__list" role="list">
                <li>Продукт проверен на конкретном бизнесе</li>
                <li>Единоразовая оплата, без подписок</li>
              </ul>
              <ul class="crm-card__list crm-card__list--cons" role="list">
                <li>Подходит для конкретной отрасли</li>
                <li>Меньше гибкости, чем индивидуальная</li>
              </ul>
            </div>
            <footer class="crm-card__foot">
              <p class="crm-card__price">от 5.000 ₽</p>
              <button class="btn btn--ghost btn--lure-dark crm-card__btn" type="button" data-order-open data-order-source="plan-catalog-details">
                Узнать подробнее
                <span class="crm-card__deal" aria-hidden="true">−10%</span>
              </button>
            </footer>
          </article>
          {% endif %}
        </div>

        {% if showPricing | default(true) %}
        <p class="crm-plans__pricing-link">
          <a href="#pricing">
            <span class="crm-plans__pricing-link-text">Подробнее о ценах</span>
            <svg class="crm-plans__pricing-link-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v9.5M4.5 9.5 8 13l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </p>
        {% endif %}
      </div>
    </section>
