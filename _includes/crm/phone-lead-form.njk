<form
  class="crm-phone-lead{% if phoneLeadClass %} {{ phoneLeadClass }}{% endif %}"
  data-crm-phone-lead
  data-lead-name="{{ leadName }}"
  data-lead-source="{{ leadSource }}"
  novalidate
>
  <label class="visually-hidden" for="{{ phoneLeadId }}">Телефон</label>
  <input
    class="crm-phone-lead__phone"
    id="{{ phoneLeadId }}"
    type="tel"
    name="phone"
    autocomplete="tel"
    inputmode="tel"
    maxlength="18"
    placeholder="+7 (___) ___-__-__"
    required
  >
  <button class="btn btn--primary{% if phoneLeadBtnClass %} {{ phoneLeadBtnClass }}{% endif %}" type="submit" disabled>
    {{ submitLabel }}
    {% if phoneLeadDealBtn %}<span class="crm-card__deal" aria-hidden="true">−10%</span>{% endif %}
  </button>
  {% include "crm/legal-note.njk" %}
  <p class="crm-phone-lead__error" data-crm-phone-lead-error hidden></p>
</form>
<p class="crm-phone-lead__done" data-crm-phone-lead-done hidden role="status">
  Заявка отправлена. Свяжемся с вами в течение часа.
</p>
