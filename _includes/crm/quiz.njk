    <section class="crm-quiz" id="quiz" aria-labelledby="crm-quiz-title" data-crm-quiz>
      <img class="crm-quiz__art" src="/assets/crm-quiz-bg.webp" alt="" width="1280" height="720" decoding="async">
      <div class="container crm-quiz__inner">
        <header class="section__head crm-quiz__head">
          <p class="section__eyebrow">Анкета</p>
          <h2 class="section__title" id="crm-quiz-title">Рассчитаем стоимость</h2>
          <p class="crm-quiz__lead">
            <span class="crm-quiz__mark">Ответьте на вопросы — назовём сумму и зафиксируем скидку 10% за вашим номером.</span>
          </p>
        </header>

        <ol class="crm-quiz__progress" data-quiz-progress aria-label="Шаг 1 из 4">
          <li class="is-current"><span class="visually-hidden">Вопрос 1</span></li>
          <li><span class="visually-hidden">Вопрос 2</span></li>
          <li><span class="visually-hidden">Вопрос 3</span></li>
          <li><span class="visually-hidden">Номер телефона</span></li>
        </ol>

        <form class="crm-quiz__form" data-quiz-form novalidate>
          <div class="crm-quiz__panel is-current" data-quiz-panel="1">
            <fieldset class="crm-quiz__set">
              <legend class="crm-quiz__question">Какая у вас отрасль?</legend>
              <div class="crm-quiz__choices">
                <label class="crm-quiz__choice">
                  <input type="radio" name="kind" value="services" required>
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-kind-services.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Услуги</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="kind" value="shop">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-kind-shop.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Магазин</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="kind" value="booking">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-kind-booking.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Запись клиентов</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="kind" value="stock">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-kind-stock.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Склад и учёт</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="kind" value="other">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-kind-other.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Другое</span>
                </label>
              </div>
            </fieldset>
          </div>

          <div class="crm-quiz__panel" data-quiz-panel="2" hidden>
            <fieldset class="crm-quiz__set">
              <legend class="crm-quiz__question">Сколько человек работают с заказами?</legend>
              <div class="crm-quiz__choices">
                <label class="crm-quiz__choice">
                  <input type="radio" name="team" value="1-3" required>
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-team-1-3.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">1–3</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="team" value="4-10">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-team-4-10.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">4–10</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="team" value="11-30">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-team-11-30.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">11–30</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="team" value="30+">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-team-30.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">30+</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="team" value="other">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-kind-other.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Другое</span>
                </label>
              </div>
            </fieldset>
          </div>

          <div class="crm-quiz__panel" data-quiz-panel="3" hidden>
            <fieldset class="crm-quiz__set">
              <legend class="crm-quiz__question">Что сейчас занимает больше всего времени?</legend>
              <div class="crm-quiz__choices">
                <label class="crm-quiz__choice">
                  <input type="radio" name="pain" value="leads" required>
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-pain-leads.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Разбор заявок</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="pain" value="schedule">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-pain-schedule.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Расписание</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="pain" value="stock">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-pain-stock.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Остатки</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="pain" value="reports">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-pain-reports.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Отчёты</span>
                </label>
                <label class="crm-quiz__choice">
                  <input type="radio" name="pain" value="other">
                  <img class="crm-quiz__pic" src="/assets/crm-quiz-kind-other.svg" alt="" width="256" height="256" decoding="async">
                  <span class="crm-quiz__choice-lab">Другое</span>
                </label>
              </div>
            </fieldset>
          </div>

          <div class="crm-quiz__panel" data-quiz-panel="4" hidden>
            <fieldset class="crm-quiz__set">
              <legend class="crm-quiz__question">Введите номер телефона для получения результатов</legend>
              <label class="crm-quiz__phone-field">
                <span class="visually-hidden">Телефон</span>
                <input
                  class="crm-quiz__phone"
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  inputmode="tel"
                  maxlength="18"
                  placeholder="+7 (___) ___-__-__"
                  required
                >
              </label>
              <button class="btn btn--primary crm-quiz__submit" type="submit" disabled>Отправить</button>
              {% include "crm/legal-note.njk" %}
              <p class="crm-quiz__error" data-quiz-error hidden></p>
            </fieldset>
          </div>

          <p class="crm-quiz__done" data-quiz-done hidden>Свяжемся в течение часа.</p>

          <button class="crm-quiz__back" type="button" data-quiz-back hidden>Назад</button>
        </form>
      </div>
    </section>
