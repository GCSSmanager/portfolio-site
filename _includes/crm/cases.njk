    <section class="crm-cases" id="cases" aria-labelledby="crm-cases-title">
      <div class="container">
        <div class="section__head">
          <p class="section__eyebrow">Работы</p>
          <h2 class="section__title" id="crm-cases-title">Кейсы</h2>
        </div>

        <div class="crm-cases__list">
          {% if not caseKeys or "flower" in caseKeys %}
          <article class="crm-case crm-case--flower">
            <div class="crm-case__top">
              <div class="crm-case__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <circle cx="12" cy="12" r="2.2"/>
                  <path d="M12 4.5c1.2 2.2 1.2 4.2 0 5.5-1.2-1.3-1.2-3.3 0-5.5Z"/>
                  <path d="M19.5 12c-2.2 1.2-4.2 1.2-5.5 0 1.3-1.2 3.3-1.2 5.5 0Z"/>
                  <path d="M12 19.5c-1.2-2.2-1.2-4.2 0-5.5 1.2 1.3 1.2 3.3 0 5.5Z"/>
                  <path d="M4.5 12c2.2-1.2 4.2-1.2 5.5 0-1.3 1.2-3.3 1.2-5.5 0Z"/>
                  <path d="M17.2 6.8c-2.4.5-4.1 1.7-4.7 3.4 1.7-.6 3.7-.2 4.7-3.4Z"/>
                  <path d="M17.2 17.2c-.5-2.4-1.7-4.1-3.4-4.7.6 1.7.2 3.7 3.4 4.7Z"/>
                  <path d="M6.8 17.2c2.4-.5 4.1-1.7 4.7-3.4-1.7.6-3.7.2-4.7 3.4Z"/>
                  <path d="M6.8 6.8c.5 2.4 1.7 4.1 3.4 4.7-.6-1.7-.2-3.7-3.4-4.7Z"/>
                </svg>
              </div>
              <div class="crm-case__intro">
                <p class="crm-case__tag">Цветочный магазин</p>
                <h3 class="crm-case__title">Склад под контролем</h3>
              </div>
            </div>
            <p class="crm-case__note">Склад без сюрпризов: приёмка и инвентаризация — минуты, не часы.</p>
            <ul class="crm-case__metrics">
              <li>
                <p class="crm-case__value">−35%</p>
                <p class="crm-case__label">списания цветов</p>
              </li>
              <li>
                <p class="crm-case__value">15 мин</p>
                <p class="crm-case__label">приёмка и инвентаризация вместо часов</p>
              </li>
              <li>
                <p class="crm-case__value">−50%</p>
                <p class="crm-case__label">отказов клиенту «нет в наличии»</p>
              </li>
            </ul>
          </article>
          {% endif %}

          {% if not caseKeys or "pest" in caseKeys %}
          <article class="crm-case crm-case--pest">
            <div class="crm-case__top">
              <div class="crm-case__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <ellipse cx="12" cy="13" rx="4.2" ry="5"/>
                  <circle cx="10.2" cy="11.5" r=".7" fill="currentColor" stroke="none"/>
                  <circle cx="13.8" cy="11.5" r=".7" fill="currentColor" stroke="none"/>
                  <path d="M10 8.2 8 4.8M14 8.2l2-3.4"/>
                  <path d="M7.2 11H4.5M19.5 11H16.8"/>
                  <path d="M7.5 16.5 5 18.5M16.5 16.5 19 18.5"/>
                  <path d="M8.2 14H5M19 14h-3.2"/>
                </svg>
              </div>
              <div class="crm-case__intro">
                <p class="crm-case__tag">Дезинсекция</p>
                <h3 class="crm-case__title">Реклама окупается</h3>
              </div>
            </div>
            <p class="crm-case__note">От локального бизнеса — к сети: аналитика, города и контроль смены.</p>
            <ul class="crm-case__metrics">
              <li>
                <p class="crm-case__value">+400%</p>
                <p class="crm-case__label">выручка за полгода</p>
              </li>
              <li>
                <p class="crm-case__value">3+</p>
                <p class="crm-case__label">города вместо одного</p>
              </li>
              <li>
                <p class="crm-case__value">100%</p>
                <p class="crm-case__label">смена мастеров и операторов на контроле</p>
              </li>
            </ul>
          </article>
          {% endif %}

          {% if not caseKeys or "clinic" in caseKeys %}
          <article class="crm-case crm-case--clinic">
            <div class="crm-case__top">
              <div class="crm-case__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path d="M8 3.5h8v5h5v8h-5v5H8v-5H3v-8h5v-5z"/>
                </svg>
              </div>
              <div class="crm-case__intro">
                <p class="crm-case__tag">Медицинский центр</p>
                <h3 class="crm-case__title">Расписание и документы</h3>
              </div>
            </div>
            <p class="crm-case__note">Спокойная запись к специалистам и документы без ручной сборки.</p>
            <ul class="crm-case__metrics">
              <li>
                <p class="crm-case__value">2 мин</p>
                <p class="crm-case__label">на документы вместо ~20</p>
              </li>
              <li>
                <p class="crm-case__value">0%</p>
                <p class="crm-case__label">пересечённых записей</p>
              </li>
              <li>
                <p class="crm-case__value">+12%</p>
                <p class="crm-case__label">загрузка расписания</p>
              </li>
            </ul>
          </article>
          {% endif %}
        </div>
      </div>
    </section>
