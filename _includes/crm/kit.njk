    <section class="crm-kit" aria-labelledby="crm-kit-title">
      <div class="container">
        <div class="section__head crm-kit__head">
          <p class="section__eyebrow">Бесплатный пакет</p>
          <h2 class="section__title" id="crm-kit-title">Что входит</h2>
          <p class="section__lead">База, сделки и задачи — чтобы вести продажи в одном месте.</p>
        </div>

        <div class="crm-kit__stage">
          <ul class="crm-kit__grid" role="list">
          <li class="crm-kit__item crm-kit__item--rose">
            <div class="crm-kit__top">
              <div class="crm-kit__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <circle cx="9" cy="8.2" r="2.6"/>
                  <path d="M4.6 17.6c.7-3 2.4-4.4 4.4-4.4s3.7 1.4 4.4 4.4"/>
                  <rect x="13.2" y="6.4" width="6.6" height="8.4" rx="1.4"/>
                  <path d="M14.8 9.2h3.4M14.8 11.6h2.4"/>
                </svg>
              </div>
              <h3 class="crm-kit__name">Клиенты</h3>
            </div>
            <p class="crm-kit__text">Контакты и карточки в одной базе.</p>
          </li>
          <li class="crm-kit__item crm-kit__item--green">
            <div class="crm-kit__top">
              <div class="crm-kit__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path d="M4.5 7.2h5.2L11.4 10H19.5v8.2H4.5V7.2Z" stroke-linejoin="round"/>
                  <path d="M7.4 13.4h9.2M7.4 16h6.4" stroke-linecap="round"/>
                </svg>
              </div>
              <h3 class="crm-kit__name">Сделки</h3>
            </div>
            <p class="crm-kit__text">Воронка и статусы по каждому клиенту.</p>
          </li>
          <li class="crm-kit__item crm-kit__item--blue">
            <div class="crm-kit__top">
              <div class="crm-kit__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <rect x="6.2" y="4.6" width="11.6" height="15.2" rx="1.8"/>
                  <path d="M9.2 4.6V3.8a2 2 0 0 1 2-1.6h1.6a2 2 0 0 1 2 1.6v.8" stroke-linecap="round"/>
                  <path d="M8.8 11.2 10.6 13l3.4-3.6" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M8.8 16.4h6.4" stroke-linecap="round"/>
                </svg>
              </div>
              <h3 class="crm-kit__name">Задачи</h3>
            </div>
            <p class="crm-kit__text">Напоминания, чтобы ничего не потерялось.</p>
          </li>
          <li class="crm-kit__item crm-kit__item--terra">
            <div class="crm-kit__top">
              <div class="crm-kit__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <circle cx="9" cy="8.4" r="2.5"/>
                  <path d="M4.8 17.8c.7-3.2 2.4-4.6 4.2-4.6s3.5 1.4 4.2 4.6"/>
                  <circle cx="16" cy="8.8" r="2.1"/>
                  <path d="M13.6 17.8c.5-2.6 1.8-3.8 3.2-3.8 1.8 0 3.2 1.4 3.8 3.8"/>
                </svg>
              </div>
              <h3 class="crm-kit__name">Команда</h3>
            </div>
            <p class="crm-kit__text">Общая база для тех, кто продаёт.</p>
          </li>
        </ul>

          <div class="crm-kit__action">
            <button class="btn btn--primary btn--lure-dark" type="button" data-order-open data-order-source="kit-free" data-order-deal="off">
              Получить бесплатно
            </button>
          </div>
        </div>
      </div>
    </section>
