  <div class="modal modal--demos" id="demoPickerModal" hidden aria-hidden="true">
    <div class="modal__overlay" data-demo-picker-close></div>
    <div class="modal__panel modal__panel--demos" role="dialog" aria-modal="true" aria-labelledby="demoPickerTitle">
      <div class="modal__header">
        <h2 class="modal__title" id="demoPickerTitle">Выберите демо CRM</h2>
        <button class="modal__close" type="button" tabindex="-1" aria-label="Закрыть" data-demo-picker-close>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13"/>
          </svg>
        </button>
      </div>
      <div class="modal__body">
        <ul class="crm-demo-picker__list">
          <li>
            <a class="crm-demo-picker__card crm-demo-picker__card--flower" href="/crm/demo/flower/" target="_blank" rel="noopener" data-demo-picker-link>
              <span class="crm-demo-picker__thumb">
                <img src="/data/flower-crm/thumbnail.webp" alt="" width="640" height="360" loading="lazy" decoding="async">
              </span>
              <span class="crm-demo-picker__copy">
                <span class="crm-demo-picker__tag">Цветочный магазин</span>
                <span class="crm-demo-picker__name">Склад, уход, продажи</span>
                <span class="crm-demo-picker__go">
                  <span>Открыть демо</span>
                  <svg class="crm-demo-picker__go-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3.5 8h7.5M8.5 5.5 11 8l-2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
            </a>
          </li>
          <li>
            <a class="crm-demo-picker__card crm-demo-picker__card--clinic" href="/crm/demo/clinic/" target="_blank" rel="noopener" data-demo-picker-link>
              <span class="crm-demo-picker__thumb">
                <img src="/data/clinic-crm/thumbnail.webp" alt="" width="640" height="360" loading="lazy" decoding="async">
              </span>
              <span class="crm-demo-picker__copy">
                <span class="crm-demo-picker__tag">Медицинский центр</span>
                <span class="crm-demo-picker__name">Запись, расписание, документы</span>
                <span class="crm-demo-picker__go">
                  <span>Открыть демо</span>
                  <svg class="crm-demo-picker__go-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3.5 8h7.5M8.5 5.5 11 8l-2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
