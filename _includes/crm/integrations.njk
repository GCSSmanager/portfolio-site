    <section class="crm-bridges" id="integrations" aria-labelledby="crm-bridges-title">
      <div class="container">
        <div class="section__head">
          <p class="section__eyebrow">Интеграции</p>
          <h2 class="section__title" id="crm-bridges-title">Куда попадает заявка</h2>
        </div>

        <ul class="crm-bridges__list" role="list">
          <li class="crm-bridge crm-bridge--direct">
            <div class="crm-bridge__stage" aria-hidden="true">
              <div class="crm-bridge__from">
                <span class="crm-bridge__kicker">Директ</span>
                <span class="crm-bridge__line"></span>
                <span class="crm-bridge__line crm-bridge__line--short"></span>
              </div>
              <span class="crm-bridge__arrow"></span>
              <div class="crm-bridge__to crm-bridge__to--card">
                <span class="crm-bridge__avatar"></span>
                <span class="crm-bridge__lines">
                  <span class="crm-bridge__line"></span>
                  <span class="crm-bridge__line crm-bridge__line--short"></span>
                </span>
                <span class="crm-bridge__kicker">Карточка</span>
              </div>
            </div>
            <h3 class="crm-bridge__title">Заявки из Директа в карточку клиента</h3>
          </li>

          <li class="crm-bridge crm-bridge--chat">
            <div class="crm-bridge__stage" aria-hidden="true">
              <div class="crm-bridge__from">
                <span class="crm-bridge__kicker">Заявка</span>
                <span class="crm-bridge__dot"></span>
                <span class="crm-bridge__line"></span>
                <span class="crm-bridge__line crm-bridge__line--short"></span>
              </div>
              <span class="crm-bridge__arrow"></span>
              <div class="crm-bridge__to crm-bridge__to--chat">
                <span class="crm-bridge__bubble">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M4 11.5 20 4.5 14.5 20l-2.2-6.2L4 11.5Z"/>
                    <path d="M12.3 13.8 20 4.5"/>
                  </svg>
                  <span class="crm-bridge__line"></span>
                  <span class="crm-bridge__line crm-bridge__line--short"></span>
                </span>
                <span class="crm-bridge__kicker">Telegram</span>
              </div>
            </div>
            <h3 class="crm-bridge__title">Уведомление о заявке в Telegram</h3>
          </li>

          <li class="crm-bridge crm-bridge--inbox">
            <div class="crm-bridge__stage" aria-hidden="true">
              <div class="crm-bridge__from crm-bridge__from--pair">
                <span class="crm-bridge__chip">
                  <span class="crm-bridge__win"></span>
                  Сайт
                </span>
                <span class="crm-bridge__chip">
                  <span class="crm-bridge__handset"></span>
                  Звонок
                </span>
              </div>
              <span class="crm-bridge__arrow"></span>
              <div class="crm-bridge__to crm-bridge__to--list">
                <span class="crm-bridge__row"></span>
                <span class="crm-bridge__row"></span>
                <span class="crm-bridge__row"></span>
                <span class="crm-bridge__kicker">Одно окно</span>
              </div>
            </div>
            <h3 class="crm-bridge__title">Заявки с сайта и телефонии в одно окно</h3>
          </li>

          <li class="crm-bridge crm-bridge--pay">
            <div class="crm-bridge__stage" aria-hidden="true">
              <div class="crm-bridge__from">
                <span class="crm-bridge__pay"></span>
                <span class="crm-bridge__kicker">Оплата</span>
              </div>
              <span class="crm-bridge__arrow"></span>
              <div class="crm-bridge__to crm-bridge__to--sheet">
                <span class="crm-bridge__sheet">
                  <span></span><span></span><span></span>
                  <span></span><span></span><span></span>
                </span>
                <span class="crm-bridge__kicker">Таблица</span>
              </div>
            </div>
            <h3 class="crm-bridge__title">В таблицу попадает только оплаченная заявка</h3>
          </li>
        </ul>

        <div class="crm-bridges__close">
          <p class="crm-bridges__pitch">Больше 1000 успешных интеграций: реклама, мессенджеры, телефония, оплаты. Напишите, как у вас приходят заявки — обсудим и соберём связку под ваш процесс.</p>
          <button class="btn btn--primary btn--lure-dark crm-bridges__cta" type="button" data-order-open data-order-source="integrations-estimate">
            Оценить задачу
            <span class="crm-card__deal" aria-hidden="true">−10%</span>
          </button>
        </div>
      </div>
    </section>
