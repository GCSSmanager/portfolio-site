    <section class="crm-bridges" id="integrations" aria-labelledby="crm-bridges-title">
      <div class="container">
        <div class="section__head">
          <p class="section__eyebrow">Интеграции</p>
          <h2 class="section__title" id="crm-bridges-title">Куда попадает заявка</h2>
        </div>

        <ul class="crm-bridges__list" role="list">
          <li class="crm-bridge crm-bridge--direct">
            <div class="crm-bridge__stage" aria-hidden="true">
              <div class="crm-bridge__node">
                <img class="crm-bridge__icon" src="/assets/crm-bridge-direct.webp" alt="" width="96" height="96" decoding="async">
                <span class="crm-bridge__label">Директ</span>
              </div>
              <span class="crm-bridge__arrow"></span>
              <div class="crm-bridge__node">
                <img class="crm-bridge__icon" src="/assets/crm-bridge-card.webp" alt="" width="96" height="96" decoding="async">
                <span class="crm-bridge__label">Карточка</span>
              </div>
            </div>
            <h3 class="crm-bridge__title">Заявки из Директа в карточку клиента</h3>
          </li>

          <li class="crm-bridge crm-bridge--chat">
            <div class="crm-bridge__stage" aria-hidden="true">
              <div class="crm-bridge__node">
                <img class="crm-bridge__icon" src="/assets/crm-bridge-lead.webp" alt="" width="96" height="96" decoding="async">
                <span class="crm-bridge__label">Заявка</span>
              </div>
              <span class="crm-bridge__arrow"></span>
              <div class="crm-bridge__node">
                <img class="crm-bridge__icon" src="/assets/crm-bridge-telegram.webp" alt="" width="96" height="96" decoding="async">
                <span class="crm-bridge__label">Telegram</span>
              </div>
            </div>
            <h3 class="crm-bridge__title">Уведомление о заявке в Telegram</h3>
          </li>

          <li class="crm-bridge crm-bridge--inbox">
            <div class="crm-bridge__stage crm-bridge__stage--duo" aria-hidden="true">
              <div class="crm-bridge__from-duo">
                <div class="crm-bridge__node crm-bridge__node--mini">
                  <img class="crm-bridge__icon" src="/assets/crm-bridge-site.webp" alt="" width="80" height="80" decoding="async">
                  <span class="crm-bridge__label">Сайт</span>
                </div>
                <div class="crm-bridge__node crm-bridge__node--mini">
                  <img class="crm-bridge__icon" src="/assets/crm-bridge-phone.webp" alt="" width="80" height="80" decoding="async">
                  <span class="crm-bridge__label">Звонок</span>
                </div>
              </div>
              <span class="crm-bridge__arrow"></span>
              <div class="crm-bridge__node">
                <img class="crm-bridge__icon" src="/assets/crm-bridge-inbox.webp" alt="" width="96" height="96" decoding="async">
                <span class="crm-bridge__label">Одно окно</span>
              </div>
            </div>
            <h3 class="crm-bridge__title">Заявки с сайта и телефонии в одно окно</h3>
          </li>

          <li class="crm-bridge crm-bridge--pay">
            <div class="crm-bridge__stage" aria-hidden="true">
              <div class="crm-bridge__node">
                <img class="crm-bridge__icon" src="/assets/crm-bridge-pay.webp" alt="" width="96" height="96" decoding="async">
                <span class="crm-bridge__label">Оплата</span>
              </div>
              <span class="crm-bridge__arrow"></span>
              <div class="crm-bridge__node">
                <img class="crm-bridge__icon" src="/assets/crm-bridge-sheet.webp" alt="" width="96" height="96" decoding="async">
                <span class="crm-bridge__label">Таблица</span>
              </div>
            </div>
            <h3 class="crm-bridge__title">В таблицу попадает только оплаченная заявка</h3>
          </li>
        </ul>

        <div class="crm-bridges__close">
          <p class="crm-bridges__pitch">Больше 1000 успешных интеграций: реклама, мессенджеры, телефония, оплаты. Напишите, как у вас приходят заявки — обсудим и соберём связку под ваш процесс.</p>
          <button class="btn btn--primary btn--lure-dark crm-bridges__cta" type="button" data-order-open data-order-source="integrations-estimate">
            Оценить задачу
            <span class="crm-card__deal" aria-hidden="true">−10%</span>
          </button>
        </div>
      </div>
    </section>
