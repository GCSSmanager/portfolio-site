<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://gcss-portfolio.ru/#organization",
      "name": "ГКСС",
      "alternateName": "Гибкие корпоративные системы и сервисы",
      "url": "https://gcss-portfolio.ru/crm/custom/",
      "logo": "https://gcss-portfolio.ru/assets/gcss-logo.webp",
      "email": "diatimp@gmail.com",
      "telephone": "+79963463049",
      "address": {
        "@type": "PostalAddress",
        "postalCode": "129366",
        "addressLocality": "Москва",
        "streetAddress": "ул. Ярославская, д. 15, к. 3",
        "addressCountry": "RU"
      },
      "sameAs": [
        "https://t.me/GCSSmanager"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://gcss-portfolio.ru/#website",
      "url": "https://gcss-portfolio.ru/",
      "name": "ГКСС",
      "inLanguage": "ru",
      "publisher": {
        "@id": "https://gcss-portfolio.ru/#organization"
      }
    },
    {
      "@type": "WebPage",
      "@id": {{ (canonical ~ "#webpage") | jsonld | safe }},
      "url": {{ canonical | jsonld | safe }},
      "name": {{ title | jsonld | safe }},
      "description": {{ description | jsonld | safe }},
      "inLanguage": "ru",
      "isPartOf": {
        "@id": "https://gcss-portfolio.ru/#website"
      },
      "publisher": {
        "@id": "https://gcss-portfolio.ru/#organization"
      }
    }{% if solution == "custom" or solution == "free" or solution == "integrations" %},
    {
      "@type": "Service",
      "@id": {{ (canonical ~ "#service") | jsonld | safe }},
      "name": {{ title | jsonld | safe }},
      "description": {{ description | jsonld | safe }},
      "url": {{ canonical | jsonld | safe }},
      "provider": {
        "@id": "https://gcss-portfolio.ru/#organization"
      },
      "areaServed": "RU"
    }{% endif %}
  ]
}
</script>
