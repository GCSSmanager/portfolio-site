    <section class="crm-guide{% if faqVariant == "free" %} crm-guide--plain{% endif %}" id="guide" aria-labelledby="crm-guide-title">
      <div class="container">
        <div class="crm-guide__layout">
          <div class="crm-guide__intro">
            <div class="section__head">
              <p class="section__eyebrow">Коротко</p>
              <h2 class="section__title" id="crm-guide-title">Частые вопросы</h2>
            </div>
            <p class="crm-guide__lead">Не нашли ответа на свой вопрос — <a href="tel:+79963463049" data-phone-link>звоните нам</a>!</p>
            <div class="crm-guide__action">
              {% if faqVariant != "free" %}
              <span class="crm-guide__deal-bg" aria-hidden="true">−10%</span>
              {% endif %}
              {% set phoneLeadId = "guide-phone" %}
              {% set leadName = "Бесплатная консультация" %}
              {% set leadSource = "guide-consult" %}
              {% set submitLabel = "Бесплатная консультация" %}
              {% set phoneLeadBtnClass = "btn--lure-dark crm-guide__cta" %}
              {% set phoneLeadDealBtn = false %}
              {% include "crm/phone-lead-form.njk" %}
            </div>
          </div>

          <div class="crm-guide__list" data-guide-faq{% if faqVariant %} data-faq-variant="{{ faqVariant }}"{% endif %}></div>
        </div>
      </div>
    </section>
