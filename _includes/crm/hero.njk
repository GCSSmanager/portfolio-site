    <section class="crm-hero" aria-label="{% if heroMark %}{{ heroTitle }} {{ heroMark }}{% elif heroTitle %}{{ heroTitle }}{% else %}Бесплатная CRM-система с установкой для отслеживания продаж{% endif %}">
      <img
        class="crm-hero__bg"
        src="/assets/crm-hero.webp"
        alt=""
        width="3840"
        height="2160"
        fetchpriority="high"
      >
      <div class="crm-hero__scrim" aria-hidden="true"></div>
      <div class="container crm-hero__inner">
        <div class="crm-hero__copy reveal">
          <h1 class="crm-hero__title">
            {% if heroMark %}
            {{ heroTitle }}<br>
            <span class="crm-hero__mark">{{ heroMark }}</span>
            {% elif heroTitle %}
            {{ heroTitle }}
            {% else %}
            <span class="crm-hero__mark">Бесплатная</span> CRM-система с установкой для отслеживания продаж
            {% endif %}
          </h1>
          <div class="crm-hero__rule" aria-hidden="true"></div>
          <div class="crm-hero__texts">
            <p class="crm-hero__text">
              {{ heroText | default("CRM — это программа, где заявки, клиенты и продажи ведутся в одном месте, а не в таблицах и мессенджерах.") }}
            </p>
            {% if heroMore %}
            <p class="crm-hero__text">{{ heroMore }}</p>
            {% endif %}
          </div>
          <form class="crm-hero__form" data-hero-estimate{% if dealAlways %} data-lead-name="Скидка 10%" data-lead-source="hero-deal"{% endif %}>
            <label class="visually-hidden" for="heroPhone">Телефон</label>
            <input
              class="crm-hero__phone"
              id="heroPhone"
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="numeric"
              placeholder="+7 (___) ___-__-__"
              required
            >
            <button class="btn btn--primary btn--lure-light crm-hero__btn" type="submit" disabled>
              {{ heroCta | default("Получить бесплатно") }}
              {% if dealAlways %}<span class="crm-card__deal" aria-hidden="true">−10%</span>{% endif %}
            </button>
            <p class="crm-hero__form-error" data-hero-estimate-error hidden></p>
          </form>
          <p class="crm-hero__done" data-hero-estimate-done hidden role="status">
            Заявка отправлена. Свяжемся с вами в течение часа.
          </p>
        </div>

        <aside class="crm-hero__perks reveal" aria-label="Условия">
          <ul class="crm-hero__perks-list">
            <li>
              <span class="crm-hero__perk-value">1 неделя</span>
              <span class="crm-hero__perk-label">запуск из любого города</span>
            </li>
            <li>
              <span class="crm-hero__perk-value">Бессрочно</span>
              <span class="crm-hero__perk-label">поддержка после сдачи</span>
            </li>
            <li>
              <span class="crm-hero__perk-value">Работа по договору</span>
            </li>
          </ul>
          <p class="crm-hero__demos-link">
            <a href="#cases">
              <span class="crm-hero__demos-link-text">
                Протестировать<br>
                бесплатно
              </span>
              <svg class="crm-hero__demos-link-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 2.5v10.5M3.8 9.2 8 13.4l4.2-4.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </p>
        </aside>
      </div>
    </section>
