<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <link rel="canonical" href="{{ canonical }}">
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content="0; url={{ url }}">
</head>
<body>
  <p><a href="{{ url }}">{{ title }}</a></p>
  <script>location.replace("{{ url }}");</script>
</body>
</html>
